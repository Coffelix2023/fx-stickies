{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for note windows, whose labels are note uuids",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "opener:default",
    "autostart:default"
  ]
}
